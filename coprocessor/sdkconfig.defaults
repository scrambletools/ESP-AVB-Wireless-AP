# Overrides applied on top of upstream esp-hosted-mcu/slave's
# sdkconfig.defaults and sdkconfig.defaults.esp32c6. Anything not set
# here inherits from upstream. Only customizations the AVB-Wireless-AP
# project genuinely needs belong in this file.

# Build the coprocessor-side PTP custom-RPC handler from the
# esp_ptp_rpc component (symlinked into ./components/).
CONFIG_PTP_RPC_BUILD_COPROCESSOR_HANDLER=y

# Bring-up diagnostics: verbose bootloader + DEBUG runtime logs on
# the coprocessor's UART0 so flash/boot issues are visible without
# rebuilding. Drop these once Phase 8 stabilizes.
CONFIG_BOOTLOADER_LOG_LEVEL_VERBOSE=y
CONFIG_LOG_DEFAULT_LEVEL_DEBUG=y

# FTM: responder on the SoftAP per IEEE 802.1AS-2020 §12.1.2. STAs
# initiate FTM bursts against the AP; this side must respond.
# Required so the STA's ptpd_inject_peer_delay path gets RTT samples.
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_RESPONDER_SUPPORT=y

# Wider A-MPDU TX BA window for bridging AVTP from wired to Wi-Fi. C6
# supports HE (Wi-Fi 6) so the Kconfig range is 2..64; the default of
# 6 keeps per-MPDU overhead high. 64 lets the aggregator pack a full
# Class A burst into one PHY transmission.
CONFIG_ESP_WIFI_TX_BA_WIN=64
# More dynamic TX buffers so the aggregator has room to accumulate
# before the BA window forces a send.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
# Match RX BA window to TX. Block-Ack negotiation locks the lower of
# the two endpoints' BA windows; without bumping the RX side too the
# AP's TX_BA_WIN=64 collapses to the peer's RX_BA_WIN=6 default.
CONFIG_ESP_WIFI_RX_BA_WIN=64
# RX_BA_WIN=64 requires DYNAMIC_RX_BUFFER_NUM >= 64 and
# STATIC_RX_BUFFER_NUM * 2 >= 64; IDF's wifi_init.c #errors otherwise.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
